---
import ImagemSite from '../components/ImagemSite.astro';
import MenuLista from '../components/MenuLista.astro';
import BuscaTopo from '../components/BuscaTopo.astro';
import Rodape from '../components/Rodape.astro';
import { cssAparencia, getAparencia, getMenuPrincipal, getParceiros, srcImagem } from '../lib/conteudo';
import { NOMES_TEMAS, TEMAS, temaDe } from '../lib/tema';

interface Props {
  // Título da página; sem ele, o do site.
  titulo?: string | null;
  descricao?: string;
  ogImagem?: string | null;
  naoIndexar?: boolean;
  // Endereço canônico, quando a página responde em mais de um.
  canonico?: string;
}

const { titulo, descricao, ogImagem, naoIndexar, canonico } = Astro.props;
const [aparencia, menu, parceiros] = await Promise.all([getAparencia(), getMenuPrincipal(), getParceiros()]);

const tituloPagina = titulo ? `${titulo} · ${aparencia.nome}` : `${aparencia.nome} · ${aparencia.subtitulo}`;
const descricaoPagina = descricao || aparencia.subtitulo;
const caminho = Astro.url.pathname;
const urlCanonica = new URL(canonico ?? caminho, Astro.site).toString();
const imagem = new URL(ogImagem || '/static/img/compartilhar.jpg', Astro.site).toString();
const topo = srcImagem(aparencia.imagemTopo);
const fundoTopo = /^\/(?!\/)|^https:/.test(topo) ? topo : '/static/img/bg_topo.jpg';

// Proposta de interface em uso (só nesta branch; ver src/lib/tema.ts).
const tema = temaDe(Astro.cookies);
const linkTema = (t: string) => {
  const url = new URL(Astro.url);
  url.searchParams.set('tema', t);
  return `${url.pathname}${url.search}`;
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricaoPagina} />
    <meta name="robots" content={naoIndexar ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={urlCanonica} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={aparencia.nome} />
    <meta property="og:title" content={titulo || aparencia.nome} />
    <meta property="og:description" content={descricaoPagina} />
    <meta property="og:image" content={imagem} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/static/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {tema === 'b' && <link rel="preload" href="/static/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href="/static/css/site.css" />
    {tema !== 'atual' && <link rel="stylesheet" href="/static/css/temas/comum.css" />}
    {tema !== 'atual' && <link rel="stylesheet" href={`/static/css/temas/${tema}.css`} />}
    <link rel="stylesheet" href="/static/css/temas/previa.css" />
    {/* Só cores validadas (#rrggbb) em src/lib/conteudo.ts. */}
    <style is:inline set:html={`${cssAparencia(aparencia)}.topo{background-image:url("${encodeURI(fundoTopo).replace(/"/g, '')}")}`} />
  </head>
  <body class={`tema-${tema}`}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <nav class="previa" aria-label="Propostas de interface">
      <span>Prévia da interface:</span>
      <ul>
        {TEMAS.map((t) => (
          <li>
            <a href={linkTema(t)} aria-current={t === tema ? 'true' : undefined}>{NOMES_TEMAS[t]}</a>
          </li>
        ))}
      </ul>
    </nav>
    {
      tema === 'c' ? (
        <div class="leiaute">
          <header class="lateral">
            <div class="lateral-interno">
              <a class="lateral-nome" href="/">
                <span class="lateral-titulo">{aparencia.nome}</span>
                <span class="lateral-sub">{aparencia.subtitulo}</span>
              </a>
              <nav class="menu" aria-label="Menu principal">
                <details class="menu-movel">
                  <summary>Menu</summary>
                  <MenuLista itens={menu} caminho={caminho} />
                </details>
                <MenuLista itens={menu} caminho={caminho} classe="menu-largo" />
              </nav>
              <BuscaTopo />
            </div>
          </header>
          <div class="coluna">
            <main id="conteudo" class="principal">
              <slot />
            </main>
            <Rodape aparencia={aparencia} parceiros={parceiros} />
          </div>
        </div>
      ) : (
        <>
          {tema === 'b' ? (
            <header class="cabeca">
              <div class="envoltorio cabeca-util">
                <a class="unesp" href="https://www.unesp.br" rel="noopener" target="_blank">
                  <img src="/static/img/unesp-logo.png" alt="Unesp" width="139" height="47" />
                </a>
                <BuscaTopo />
              </div>
              <div class="envoltorio cabeca-titulo">
                <a class="cabeca-nome" href="/">{aparencia.nome}</a>
                <p class="cabeca-sub">{aparencia.subtitulo}</p>
              </div>
            </header>
          ) : (
            <header class="topo">
              <div class="envoltorio topo-interno">
                <a class="marca" href="/" aria-label={`${aparencia.nome}: página inicial`} {...aparencia.edit?.logo}>
                  {aparencia.logo ? (
                    <ImagemSite imagem={aparencia.logo} alt={aparencia.nome} />
                  ) : (
                    <img src="/static/img/logo-transfopress-brasil.png" alt={aparencia.nome} width="564" height="93" />
                  )}
                </a>
                <div class="topo-direita">
                  <a class="unesp" href="https://www.unesp.br" rel="noopener" target="_blank">
                    <img src="/static/img/unesp-logo.png" alt="Unesp" width="139" height="47" />
                  </a>
                  <BuscaTopo />
                </div>
              </div>
            </header>
          )}
          <nav class="menu" aria-label="Menu principal">
            <div class="envoltorio">
              <details class="menu-movel">
                <summary>Menu</summary>
                <MenuLista itens={menu} caminho={caminho} />
              </details>
              <MenuLista itens={menu} caminho={caminho} classe="menu-largo" />
            </div>
          </nav>
          <main id="conteudo" class="envoltorio principal">
            <slot />
          </main>
          <Rodape aparencia={aparencia} parceiros={parceiros} />
        </>
      )
    }
  </body>
</html>
