---
import type { Rede } from '../lib/conteudo';

interface Props {
  redes: { tipo: Rede; url: string }[];
  nome: string;
  classe?: string;
}
const { redes, nome, classe } = Astro.props;

const ICONES: Record<Rede, [string, string]> = {
  facebook: ['Facebook', '<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"/>'],
  instagram: ['Instagram', '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2"/>'],
  linkedin: ['LinkedIn', '<path d="M4.5 9h3v11h-3zM6 3.8a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM10 9h2.9v1.5h.1c.4-.8 1.4-1.7 3-1.7 3.1 0 3.7 2 3.7 4.7V20h-3v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V20h-3z"/>'],
  youtube: ['YouTube', '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z"/>'],
  academia: ['Academia.edu', '<path d="M12 3 1.5 9 12 15l8.5-4.9V16h2V9zM5.5 13.2v3.3C7 18.3 9.4 19.5 12 19.5s5-1.2 6.5-3v-3.3L12 17z"/>'],
  x: ['X', '<path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/>'],
};
---

{
  redes.length > 0 && (
    <ul class:list={['redes', classe]} aria-label="Redes sociais">
      {redes.map(({ tipo, url }) => (
        <li>
          <a href={url} rel="noopener" target="_blank" aria-label={`${nome}: ${ICONES[tipo][0]}`} title={ICONES[tipo][0]}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={ICONES[tipo][1]} />
          </a>
        </li>
      ))}
    </ul>
  )
}
