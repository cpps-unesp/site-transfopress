---
import { Image } from 'emdash/ui';
import type { ImageValue } from 'emdash';
import { ehImagemLegado } from '../lib/conteudo';

// Imagem de um campo do EmDash. As do site antigo (public/wp-content e
// public/static) saem como <img> simples; as enviadas pelo admin passam pelo
// componente do EmDash, que gera os tamanhos.
interface Props {
  imagem: ImageValue;
  alt?: string;
  classe?: string;
  carregar?: 'lazy' | 'eager';
}
const { imagem, alt, classe, carregar = 'lazy' } = Astro.props;
const texto = alt ?? imagem.alt ?? '';
---

{
  ehImagemLegado(imagem) ? (
    <img class={classe} src={imagem.src} alt={texto} width={imagem.width} height={imagem.height} loading={carregar} decoding="async" />
  ) : (
    <Image image={imagem} alt={texto} class={classe} />
  )
}
