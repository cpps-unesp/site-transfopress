---
import TextoCompleto from '../../components/TextoCompleto.astro';
import { getTexto } from '../../lib/conteudo';

const texto = Astro.params.slug ? await getTexto('noticias', Astro.params.slug) : null;
if (!texto) return new Response(null, { status: 404 });
---

<TextoCompleto texto={texto} voltar={{ url: '/noticias', rotulo: 'Notícias' }} />
