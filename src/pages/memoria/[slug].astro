---
import TextoCompleto from '../../components/TextoCompleto.astro';
import { getTexto } from '../../lib/conteudo';

// O índice (/memoria) é a página "memoria", escrita à mão no admin.
const texto = Astro.params.slug ? await getTexto('memoria', Astro.params.slug) : null;
if (!texto) return new Response(null, { status: 404 });
---

<TextoCompleto texto={texto} voltar={{ url: '/memoria', rotulo: 'Memória' }} />
